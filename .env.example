# Freedom Cry Production Environment Configuration
# Generate random passwords using: openssl rand -hex 32

# Master Server Public Domain (HTTPS REQUIRED IN PRODUCTION)
BASE_URL=https://vpn.example.com
GIN_MODE=release

# PostgreSQL Database Credentials (Internal network only)
DB_USER=freedomcry
DB_PASSWORD=REPLACE_WITH_RANDOM_SECURE_PASSWORD
DB_NAME=freedomcry_db
DB_SSLMODE=disable

# Redis Cache Credentials (Internal network only)
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECURE_PASSWORD

# JWT Signing Secret (Minimum 32 bytes)
JWT_SECRET=REPLACE_WITH_RANDOM_SECURE_64_CHAR_HEX

# Initial Admin Password (Optional, auto-generated on first boot if omitted)
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_RANDOM_SECURE_PASSWORD
